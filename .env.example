# Long random string used to sign admin sessions. Generate one with: openssl rand -hex 32
PAYLOAD_SECRET=
# SQLite database. In Docker this lives on the /app/data volume.
DATABASE_URL=file:./data/portfolio.db
# Folder for uploaded images (defaults to ./data/media)
MEDIA_DIR=./data/media
# Creates the first admin on an empty database. Remove after first boot if you like.
PAYLOAD_ADMIN_EMAIL=
PAYLOAD_ADMIN_PASSWORD=
