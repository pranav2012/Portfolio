---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import { getImage } from 'astro:assets';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import DeskScene from '../components/DeskScene.astro';
import CommandMenu from '../components/CommandMenu.astro';
import InspectMode from '../components/InspectMode.astro';
import { getProfile, getSite, image as imageOf } from '../lib/content';
import geistLatin from '@fontsource-variable/geist/files/geist-latin-wght-normal.woff2?url';

interface Props {
    title?: string;
    description?: string | null;
    image?: string;
    type?: 'website' | 'article';
    // The home page lays out its own wide hero, with the desk inside it.
    wide?: boolean;
}
const { title, description, image, type = 'website', wide = false } = Astro.props;
const [site, profile] = await Promise.all([getSite(), getProfile()]);

const pageTitle = title ? `${title} | ${site.title}` : site.title;
const summary = description || site.description || '';
const ogImage =
    image ??
    (site.ogImage
        ? (await getImage({ src: imageOf(site.ogImage), width: 1200 })).src
        : '/images/card.png');
const ogUrl = new URL(ogImage, Astro.site).href;
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <title>{pageTitle}</title>
        {summary && <meta name="description" content={summary} />}
        <meta name="author" content={profile.name} />
        <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
        <link rel="preload" href={geistLatin} as="font" type="font/woff2" crossorigin />
        <link rel="icon" href="/favicon/favicon.ico" sizes="any" />
        <link rel="apple-touch-icon" href="/favicon/apple-touch-icon.png" />
        <link rel="alternate" type="application/rss+xml" title={site.title} href="/rss.xml" />
        <meta property="og:type" content={type} />
        <meta property="og:title" content={title ?? site.title} />
        {summary && <meta property="og:description" content={summary} />}
        <meta property="og:image" content={ogUrl} />
        <meta name="twitter:card" content="summary_large_image" />
        {site.twitterHandle && <meta name="twitter:creator" content={site.twitterHandle} />}
        <meta name="theme-color" content="#fafafa" media="(prefers-color-scheme: light)" />
        <meta name="theme-color" content="#09090b" media="(prefers-color-scheme: dark)" />

        <script is:inline>
            // Set the theme before the first paint, and again after each
            // client-side navigation swaps the document.
            const theme = () =>
                localStorage.getItem('theme') ||
                (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
            document.documentElement.dataset.theme = theme();
            document.addEventListener('astro:after-swap', () => {
                document.documentElement.dataset.theme = theme();
            });
        </script>
        <ClientRouter />

        {
            site.analyticsId && (
                <script is:inline define:vars={{ id: site.analyticsId }}>
                    // Analytics loads once the page is idle, so it never
                    // competes with the page itself.
                    window.dataLayer = window.dataLayer || [];
                    function gtag() {
                        dataLayer.push(arguments);
                    }
                    gtag('js', new Date());
                    gtag('config', id);
                    const loadAnalytics = () => {
                        const script = document.createElement('script');
                        script.async = true;
                        script.src = `https://www.googletagmanager.com/gtag/js?id=${id}`;
                        document.head.append(script);
                    };
                    addEventListener(
                        'load',
                        () => ('requestIdleCallback' in window ? requestIdleCallback(loadAnalytics, { timeout: 4000 }) : setTimeout(loadAnalytics, 2000)),
                        { once: true }
                    );
                </script>
            )
        }
    </head>
    <body class="relative isolate min-h-screen">
        <a
            href="#main"
            class="sr-only rounded-md bg-ink px-4 py-2 text-page focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-50"
        >
            Skip to content
        </a>
        <div aria-hidden="true" class="grid-backdrop pointer-events-none absolute inset-x-0 top-0 -z-10 h-[720px] opacity-70"></div>
        <Nav name={profile.name} />
        {
            wide ? (
                <div class="mx-auto max-w-6xl px-5 pt-16 sm:px-8">
                    <main id="main">
                        <slot />
                    </main>
                    <Footer name={profile.name} />
                </div>
            ) : (
                <div class="mx-auto max-w-3xl px-5 pt-16">
                    <DeskScene />
                    <main id="main" class="mx-auto max-w-[60ch]">
                        <slot />
                    </main>
                    <Footer name={profile.name} />
                </div>
            )
        }
        <CommandMenu />
        <InspectMode />
    </body>
</html>

<style is:global>
    /* The theme switch reveals itself in a circle (see ThemeToggle). */
    html.theme-switching::view-transition-old(root),
    html.theme-switching::view-transition-new(root) {
        animation: none;
        mix-blend-mode: normal;
    }
</style>
