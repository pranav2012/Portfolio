---
// The voxel desk at the top of every page. It's kept mounted across page
// navigations; three.js loads once.
---

<div
    transition:persist="desk"
    data-desk
    role="img"
    aria-label="A voxel model of Pranav at his desk, drinking coffee"
    class="relative mx-auto -mt-5 -mb-10 size-[280px] cursor-grab touch-pan-y active:cursor-grabbing sm:-mt-15 sm:-mb-35 sm:size-[480px] md:-mt-30 md:-mb-50 md:size-[640px]"
>
</div>

<script>
    document.addEventListener('astro:page-load', async () => {
        const container = document.querySelector<HTMLElement>('[data-desk]');
        if (!container || container.dataset.mounted !== undefined) return;
        container.dataset.mounted = '';
        const { mount } = await import('../scene/mount');
        mount(container);
    });
</script>
