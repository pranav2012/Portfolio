---
// One post in a list: the blog index groups these by year, so it can drop
// the year from the date; the home page shows the full date.
import { formatDate, formatDay, readingTime, type Post } from '../lib/content';

interface Props {
    post: Post;
    heading?: 'h2' | 'h3';
    shortDate?: boolean;
}
const { post, heading: Heading = 'h3', shortDate = false } = Astro.props;
const minutes = readingTime(post.contentHtml);
---

<li class="group relative grid gap-x-8 gap-y-2 px-5 py-5 transition-colors hover:bg-raised sm:grid-cols-[1fr_auto] sm:px-6" data-component="PostRow">
    <div class="min-w-0">
        <Heading class="text-base leading-snug font-medium text-pretty sm:text-[17px]">
            <a href={`/blog/${post.slug}`} class="after:absolute after:inset-0 group-hover:text-accent">{post.title}</a>
        </Heading>
        {post.excerpt && <p class="mt-1.5 line-clamp-2 max-w-[70ch] text-sm leading-relaxed text-dim">{post.excerpt}</p>}
        {
            post.tags && post.tags.length > 0 && (
                <p class="mt-3 hidden flex-wrap gap-1.5 sm:flex">
                    {post.tags.slice(0, 4).map(tag => <span class="chip">{tag}</span>)}
                </p>
            )
        }
    </div>
    <p class="order-first flex items-center gap-2 font-mono text-xs text-faint sm:order-none sm:flex-col sm:items-end sm:gap-1 sm:pt-1">
        <time datetime={post.publishedAt}>{shortDate ? formatDay(post.publishedAt) : formatDate(post.publishedAt)}</time>
        {minutes && <span aria-hidden="true" class="sm:hidden">·</span>}
        {minutes && <span>{minutes} min read</span>}
    </p>
</li>
