<script>
    // The small WAAPI-based build, plus the spring curve generator.
    import { animate } from 'motion/mini';
    import { spring } from 'motion';

    const reduce = () => matchMedia('(prefers-reduced-motion: reduce)').matches;

    // Videos play in place: the thumbnail gives way to the player.
    document.addEventListener('click', event => {
        const button = (event.target as Element).closest('[data-video] > button');
        if (!button) return;
        const frame = button.parentElement as HTMLElement;
        const iframe = document.createElement('iframe');
        iframe.src = `https://www.youtube-nocookie.com/embed/${frame.dataset.video}?autoplay=1&rel=0`;
        iframe.title = button.getAttribute('aria-label')?.replace(/^Play /, '') ?? 'Video';
        iframe.allow = 'accelerometer; autoplay; encrypted-media; gyroscope; picture-in-picture';
        iframe.allowFullscreen = true;
        iframe.className = 'aspect-video w-full';
        button.replaceWith(iframe);
        if (!reduce()) {
            animate(
                frame,
                { transform: ['scale(0.97)', 'scale(1)'] },
                { type: spring, bounce: 0.3, duration: 0.5 }
            );
            animate(iframe, { opacity: [0, 1] }, { duration: 0.4 });
        }
    });
</script>
