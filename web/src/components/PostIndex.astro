---
import { formatDate, type Post } from '../lib/content';

interface Props {
    posts: Post[];
}
const { posts } = Astro.props;
---

<ol class="border-t border-line">
    {
        posts.map(post => (
            <li class="group relative grid gap-1 border-b border-line py-5 sm:grid-cols-[8.5rem_1fr] sm:gap-6">
                <time datetime={post.publishedAt} class="text-sm text-muted tabular-nums sm:pt-1">
                    {formatDate(post.publishedAt)}
                </time>
                <div>
                    <h3 class="font-display text-lg font-semibold tracking-tight">
                        <a
                            href={`/blog/${post.slug}`}
                            class="link after:absolute after:inset-0"
                        >
                            {post.title}
                        </a>
                    </h3>
                    {post.excerpt && (
                        <p class="mt-1 text-[0.95rem] leading-relaxed text-muted">{post.excerpt}</p>
                    )}
                </div>
            </li>
        ))
    }
</ol>
