---
import type { Project } from '../lib/content';

interface Props {
    projects: Project[];
}
const { projects } = Astro.props;
---

<ul class="border-t border-line">
    {
        projects.map(({ title, summary, url, links, year, stack }) => {
            const href = url ?? links?.[0]?.url;
            return (
                <li class="group relative border-b border-line">
                    {/* The row tint sweeps in from the left on hover. */}
                    <span
                        class="absolute inset-0 origin-left scale-x-0 bg-surface transition-transform duration-500 ease-out-soft group-hover:scale-x-100 group-focus-within:scale-x-100"
                        aria-hidden="true"
                    />
                    <div class="relative grid gap-1 px-3 py-5 sm:grid-cols-[1fr_auto] sm:gap-6">
                        <div>
                            <h3 class="font-display text-lg font-semibold tracking-tight">
                                {href ? (
                                    <a
                                        href={href}
                                        target="_blank"
                                        rel="noopener noreferrer"
                                        class="after:absolute after:inset-0 focus-visible:outline-none"
                                    >
                                        {title}
                                    </a>
                                ) : (
                                    title
                                )}
                            </h3>
                            <p class="mt-1 text-[0.95rem] leading-relaxed text-muted">{summary}</p>
                            {stack && stack.length > 0 && (
                                <p class="mt-2 text-sm text-muted/80">{stack.join(', ')}</p>
                            )}
                        </div>
                        {year && <span class="text-sm text-muted tabular-nums sm:pt-1">{year}</span>}
                    </div>
                </li>
            );
        })
    }
</ul>
