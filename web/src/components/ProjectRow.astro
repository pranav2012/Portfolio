---
import { Image } from 'astro:assets';
import { image, type Project } from '../lib/content';

interface Props {
    project: Project;
    flip?: boolean;
}
const { project, flip = false } = Astro.props;
const { title, summary, thumbnail, url, year, stack } = project;
const links = project.links ?? [];
const href = url ?? links[0]?.url;
---

<article class="grid items-center gap-6 md:grid-cols-2 md:gap-10">
    <a
        href={href}
        target="_blank"
        rel="noopener noreferrer"
        tabindex="-1"
        aria-hidden="true"
        data-glow
        class:list={[
            'group relative block overflow-hidden rounded-2xl border border-line bg-surface',
            flip && 'md:order-2'
        ]}
    >
        {
            thumbnail ? (
                <Image
                    src={image(thumbnail)}
                    alt=""
                    widths={[480, 800, 1200]}
                    sizes="(min-width: 768px) 520px, 100vw"
                    class="aspect-[1200/630] w-full object-cover transition-transform duration-700 ease-out-soft group-hover:scale-[1.03]"
                />
            ) : (
                <div class="grid aspect-[1200/630] place-items-center font-display text-2xl font-semibold">
                    {title}
                </div>
            )
        }
        <!-- A soft light that follows the cursor (see Interactions). -->
        <span
            class="pointer-events-none absolute inset-0 opacity-0 transition-opacity duration-300 group-hover:opacity-100"
            style="background: radial-gradient(420px circle at var(--x, 50%) var(--y, 50%), rgb(255 255 255 / 0.16), transparent 60%)"
        ></span>
    </a>

    <div>
        <div class="flex items-baseline justify-between gap-4">
            <h3 class="font-display text-[1.75rem] leading-tight font-semibold tracking-tight">
                {
                    href ? (
                        <a href={href} target="_blank" rel="noopener noreferrer" class="link">
                            {title}
                        </a>
                    ) : (
                        title
                    )
                }
            </h3>
            {year && <span class="text-sm text-muted tabular-nums">{year}</span>}
        </div>
        <p class="mt-3 leading-relaxed text-muted">{summary}</p>
        {
            stack && stack.length > 0 && (
                <ul class="mt-4 flex flex-wrap gap-1.5" aria-label="Built with">
                    {stack.map(tag => (
                        <li class="rounded-full border border-line px-2.5 py-0.5 text-[0.8rem] text-muted">
                            {tag}
                        </li>
                    ))}
                </ul>
            )
        }
        {
            links.length > 0 && (
                <p class="mt-4 flex gap-4 text-[0.95rem] font-medium">
                    {links.map(link => (
                        <a href={link.url} target="_blank" rel="noopener noreferrer" class="link-quiet">
                            {link.label}
                        </a>
                    ))}
                </p>
            )
        }
    </div>
</article>
