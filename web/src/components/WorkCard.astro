---
import { Image } from 'astro:assets';
import { image, type Project } from '../lib/content';

interface Props {
    project: Project;
}
const { project } = Astro.props;
const { title, summary, thumbnail, url, year, stack } = project;
const links = project.links ?? [];
const href = url ?? links[0]?.url;
---

<article
    class="card group relative flex flex-col overflow-hidden transition duration-300 ease-out-soft hover:-translate-y-1 hover:border-accent/40 hover:shadow-[0_24px_60px_-28px_var(--glow)]"
    data-component="WorkCard"
>
    <div class="overflow-hidden border-b border-line bg-raised">
        {
            thumbnail ? (
                <Image
                    src={image(thumbnail)}
                    alt=""
                    widths={[480, 960]}
                    sizes="(min-width: 768px) 520px, 100vw"
                    class="aspect-[1200/630] w-full object-cover transition-transform duration-700 ease-out-soft group-hover:scale-[1.03]"
                />
            ) : (
                <div class="grid aspect-[1200/630] place-items-center bg-gradient-to-br from-accent/20 to-transparent px-6 text-xl font-semibold tracking-tight">
                    {title}
                </div>
            )
        }
    </div>
    <div class="flex grow flex-col p-5">
        <div class="flex items-center justify-between gap-3">
            <h3 class="text-[17px]">
                {
                    href ? (
                        <a href={href} target="_blank" rel="noopener noreferrer" class="after:absolute after:inset-0">
                            {title}
                        </a>
                    ) : (
                        title
                    )
                }
            </h3>
            <span class="flex items-center gap-1 font-mono text-xs text-faint transition-colors group-hover:text-accent">
                {year}
                {href && <span aria-hidden="true">↗</span>}
            </span>
        </div>
        <p class="mt-2 mb-4 line-clamp-3 text-sm leading-relaxed text-dim md:line-clamp-none">{summary}</p>
        <div class="mt-auto flex flex-wrap items-center gap-1.5">
            {stack?.map(tag => <span class="chip">{tag}</span>)}
            {
                links.length > 0 && (
                    <span class="relative z-10 ml-auto flex gap-3 text-[13px]">
                        {links.map(link => (
                            <a href={link.url} target="_blank" rel="noopener noreferrer" class="text-dim hover:text-ink">
                                {link.label}
                            </a>
                        ))}
                    </span>
                )
            }
        </div>
    </div>
</article>
