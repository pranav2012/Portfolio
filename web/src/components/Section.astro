---
// A page section: the heading sits in a narrow left rail on wide screens,
// the content to its right.
interface Props {
    title: string;
    id?: string;
    wide?: boolean;
}
const { title, id, wide = false } = Astro.props;
---

<section
    id={id}
    class="mx-auto mt-24 grid max-w-6xl gap-x-12 gap-y-6 px-5 sm:mt-32 sm:px-8 lg:grid-cols-[11rem_1fr]"
    aria-labelledby={id && `${id}-title`}
>
    <h2 id={id && `${id}-title`} class="text-xl font-semibold tracking-tight lg:sticky lg:top-24 lg:self-start">
        {title}
    </h2>
    <div class:list={['min-w-0', !wide && 'max-w-2xl']}>
        <slot />
    </div>
</section>
