---
import { Image } from 'astro:assets';
import { formatDate, youtubeThumbnail, type Video } from '../lib/content';

interface Props {
    video: Video;
    // The large card at the top of the Videos page.
    featured?: boolean;
}
const { video, featured = false } = Astro.props;
const thumbnail = youtubeThumbnail(video);
---

<article
    class:list={[
        'card group flex flex-col overflow-hidden transition duration-300 ease-out-soft hover:border-line-strong',
        featured && 'lg:grid lg:grid-cols-[1.6fr_1fr]'
    ]}
    data-component={featured ? 'FeaturedVideo' : 'VideoCard'}
>
    <div class:list={['overflow-hidden bg-black', featured ? 'lg:border-r lg:border-line' : 'border-b border-line']} data-video={video.youtubeId}>
        <button type="button" class="group/play relative block w-full cursor-pointer" aria-label={`Play ${video.title}`}>
            <Image
                src={thumbnail}
                alt=""
                inferSize={typeof thumbnail === 'string'}
                widths={featured ? [720, 1280] : [400, 720]}
                sizes={featured ? '(min-width: 1024px) 700px, 100vw' : '(min-width: 1024px) 360px, (min-width: 640px) 50vw, 100vw'}
                class="aspect-video w-full object-cover opacity-90 transition duration-500 ease-out-soft group-hover/play:scale-[1.03] group-hover/play:opacity-100"
            />
            <span class="absolute inset-0 bg-gradient-to-t from-black/50 via-transparent to-transparent" aria-hidden="true"></span>
            <span
                class:list={[
                    'absolute top-1/2 left-1/2 grid -translate-1/2 place-items-center rounded-full bg-white/90 text-black shadow-lg transition-transform duration-300 ease-out-soft group-hover/play:scale-110',
                    featured ? 'size-16' : 'size-12'
                ]}
                aria-hidden="true"
            >
                <svg viewBox="0 0 24 24" class:list={['ml-0.5', featured ? 'size-7' : 'size-5']} fill="currentColor">
                    <path d="M8 5.5v13a1 1 0 0 0 1.5.86l10.5-6.5a1 1 0 0 0 0-1.72L9.5 4.64A1 1 0 0 0 8 5.5Z"></path>
                </svg>
            </span>
        </button>
    </div>
    <div class:list={['flex grow flex-col', featured ? 'p-6 lg:p-8' : 'p-4']}>
        {featured && <p class="eyebrow mb-3">Featured</p>}
        <h3 class:list={['leading-snug', featured ? 'text-2xl' : 'text-[15px]']}>
            <a href={video.url} target="_blank" rel="noopener noreferrer" class="hover:text-accent">
                {video.title}
            </a>
        </h3>
        {
            video.description && (
                <p class:list={['mt-2 leading-relaxed text-dim', featured ? 'text-[15px]' : 'line-clamp-2 text-[13.5px]']}>{video.description}</p>
            )
        }
        <div class:list={['mt-auto flex items-center justify-between gap-3', featured ? 'pt-6' : 'pt-4']}>
            {video.publishedAt && <time datetime={video.publishedAt} class="font-mono text-xs text-faint">{formatDate(video.publishedAt)}</time>}
            <a href={video.url} target="_blank" rel="noopener noreferrer" class="text-[13px] text-dim hover:text-ink">
                YouTube ↗
            </a>
        </div>
    </div>
</article>
