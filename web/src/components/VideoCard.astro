---
import { Image } from 'astro:assets';
import { formatDate, youtubeThumbnail, type Video } from '../lib/content';

interface Props {
    video: Video;
}
const { video } = Astro.props;
const thumbnail = youtubeThumbnail(video);
---

<article class="text-center">
    <div class="overflow-hidden rounded-xl bg-black" data-video={video.youtubeId}>
        <button type="button" class="group relative block w-full cursor-pointer" aria-label={`Play ${video.title}`}>
            <Image
                src={thumbnail}
                alt=""
                inferSize={typeof thumbnail === 'string'}
                widths={[400, 720]}
                sizes="(min-width: 640px) 300px, 100vw"
                class="aspect-video w-full object-cover transition-transform duration-500 ease-out-soft group-hover:scale-105"
            />
            <span
                class="absolute top-1/2 left-1/2 grid size-12 -translate-1/2 place-items-center rounded-full bg-black/60 text-white backdrop-blur transition-transform duration-300 group-hover:scale-110"
                aria-hidden="true"
            >
                <svg viewBox="0 0 24 24" class="ml-0.5 size-6" fill="currentColor">
                    <path d="M8 5.5v13a1 1 0 0 0 1.5.86l10.5-6.5a1 1 0 0 0 0-1.72L9.5 4.64A1 1 0 0 0 8 5.5Z"></path>
                </svg>
            </span>
        </button>
    </div>
    <h3 class="mt-3 font-heading text-lg leading-snug">
        <a href={video.url} target="_blank" rel="noopener noreferrer" class="hover:underline">
            {video.title}
        </a>
    </h3>
    {video.description && <p class="mt-1 text-sm">{video.description}</p>}
    {video.publishedAt && <p class="mt-1 text-xs opacity-60">{formatDate(video.publishedAt)}</p>}
</article>
