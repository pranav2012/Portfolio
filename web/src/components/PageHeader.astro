---
interface Props {
    title: string;
    intro?: string;
}
const { title, intro } = Astro.props;
---

<header class="mx-auto max-w-6xl px-5 pt-14 sm:px-8 sm:pt-20">
    <h1 class="font-display text-[clamp(2.75rem,8vw,5rem)] leading-[0.95] font-bold tracking-[-0.03em] [font-stretch:85%]">
        {title}
    </h1>
    {intro && <p class="mt-5 max-w-xl text-lg leading-relaxed text-muted">{intro}</p>}
</header>
