---
import { getProfile, getProjects } from '../lib/content';

const profile = getProfile();
const email = profile.socials?.find(s => s.platform === 'email')?.url.replace(/^mailto:/, '');

type Command = { group: string; label: string; hint?: string; href?: string; action?: string; external?: boolean };
const commands: Command[] = [
    { group: 'Pages', label: 'Home', href: '/' },
    { group: 'Pages', label: 'Work', href: '/work' },
    { group: 'Pages', label: 'Blog', href: '/blog' },
    { group: 'Pages', label: 'Videos', href: '/videos' },
    { group: 'Pages', label: 'Community', href: '/community' },
    ...getProjects()
        .filter(p => p.url ?? p.links?.[0]?.url)
        .map(p => ({ group: 'Projects', label: p.title, hint: p.year ?? undefined, href: (p.url ?? p.links?.[0]?.url)!, external: true })),
    ...(profile.resumeUrl ? [{ group: 'Actions', label: 'Open Resume', href: profile.resumeUrl, external: true }] : []),
    ...(email ? [{ group: 'Actions', label: 'Copy email', hint: email, action: `copy:${email}` }] : []),
    { group: 'Actions', label: 'Toggle theme', hint: 'T', action: 'theme' },
    { group: 'Actions', label: 'Toggle inspect mode', hint: 'I', action: 'inspect' },
    ...(profile.socials ?? [])
        .filter(s => s.platform !== 'email')
        .map(s => ({ group: 'Elsewhere', label: s.label, href: s.url, external: true }))
];
const groups = [...new Set(commands.map(c => c.group))];
---

<dialog
    data-command
    aria-label="Command menu"
    class="m-auto mt-[14vh] w-[min(560px,calc(100vw-2rem))] overflow-hidden rounded-2xl border border-line-strong bg-card p-0 text-ink shadow-2xl backdrop:bg-black/50 backdrop:backdrop-blur-sm"
>
    <div class="flex items-center gap-3 border-b border-line px-4">
        <svg viewBox="0 0 24 24" class="size-4 shrink-0 text-faint" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
            <circle cx="11" cy="11" r="7"></circle>
            <path d="m20 20-3.5-3.5"></path>
        </svg>
        <input
            data-command-input
            type="text"
            placeholder="Type a command or search…"
            autocomplete="off"
            spellcheck="false"
            role="combobox"
            aria-expanded="true"
            aria-controls="command-list"
            class="h-13 grow bg-transparent text-[15px] outline-none placeholder:text-faint"
        />
        <span class="kbd">esc</span>
    </div>
    <ul id="command-list" role="listbox" class="max-h-[50vh] overflow-y-auto p-2" data-command-list>
        {
            groups.map(group => (
                <li role="presentation" data-group={group}>
                    <p class="px-2.5 pt-2 pb-1.5 font-mono text-[11px] tracking-wider text-faint uppercase">{group}</p>
                    <ul role="presentation">
                        {commands
                            .filter(c => c.group === group)
                            .map(c => (
                                <li
                                    role="option"
                                    aria-selected="false"
                                    data-item
                                    data-href={c.href}
                                    data-action={c.action}
                                    data-external={c.external ? '' : undefined}
                                    class="flex cursor-pointer items-center justify-between gap-3 rounded-lg px-2.5 py-2 text-sm text-dim aria-selected:bg-raised aria-selected:text-ink"
                                >
                                    <span>{c.label}</span>
                                    {c.hint && <span class="truncate font-mono text-xs text-faint">{c.hint}</span>}
                                    {!c.hint && c.external && <span class="text-xs text-faint">↗</span>}
                                </li>
                            ))}
                    </ul>
                </li>
            ))
        }
        <li data-empty hidden class="px-3 py-8 text-center text-sm text-faint">No results.</li>
    </ul>
    <div class="flex items-center gap-4 border-t border-line px-4 py-2.5 text-xs text-faint">
        <span class="flex items-center gap-1.5"><span class="kbd">↑</span><span class="kbd">↓</span> navigate</span>
        <span class="flex items-center gap-1.5"><span class="kbd">↵</span> open</span>
        <span class="ml-auto flex items-center gap-1.5"><span class="kbd">⌘K</span> toggle</span>
    </div>
</dialog>

<script>
    import { navigate } from 'astro:transitions/client';

    const dialog = () => document.querySelector<HTMLDialogElement>('[data-command]')!;
    const input = () => dialog().querySelector<HTMLInputElement>('[data-command-input]')!;
    const visibleItems = () =>
        [...dialog().querySelectorAll<HTMLElement>('[data-item]')].filter(item => !item.hidden);

    let active = 0;
    const select = (index: number) => {
        const items = visibleItems();
        active = (index + items.length) % Math.max(items.length, 1);
        dialog().querySelectorAll('[data-item]').forEach(item => item.setAttribute('aria-selected', 'false'));
        items[active]?.setAttribute('aria-selected', 'true');
        items[active]?.scrollIntoView({ block: 'nearest' });
    };

    // Matches when every typed character appears in order, so "nmsf" finds NomadSafe.
    const fuzzy = (text: string, query: string) => {
        let i = 0;
        for (const char of text.toLowerCase()) if (char === query[i]) i++;
        return i === query.length;
    };

    const filter = () => {
        const query = input().value.trim().toLowerCase();
        for (const group of dialog().querySelectorAll<HTMLElement>('[data-group]')) {
            let any = false;
            for (const item of group.querySelectorAll<HTMLElement>('[data-item]')) {
                item.hidden = !fuzzy(item.textContent ?? '', query);
                any ||= !item.hidden;
            }
            group.hidden = !any;
        }
        dialog().querySelector<HTMLElement>('[data-empty]')!.hidden = visibleItems().length > 0;
        select(0);
    };

    const open = () => {
        if (dialog().open) return;
        input().value = '';
        filter();
        dialog().showModal();
        input().focus();
    };

    const run = (item: HTMLElement) => {
        dialog().close();
        const { href, action } = item.dataset;
        if (href) {
            if (item.dataset.external !== undefined) window.open(href, '_blank', 'noopener');
            else navigate(href);
        } else if (action?.startsWith('copy:')) {
            navigator.clipboard.writeText(action.slice(5));
        } else if (action === 'theme') {
            document.querySelector<HTMLButtonElement>('[data-theme-toggle]')?.click();
        } else if (action === 'inspect') {
            document.querySelector<HTMLButtonElement>('[data-xray-toggle]')?.click();
        }
    };

    const typing = (target: EventTarget | null) =>
        target instanceof HTMLElement && (target.isContentEditable || /^(INPUT|TEXTAREA|SELECT)$/.test(target.tagName));

    document.addEventListener('keydown', event => {
        if ((event.metaKey || event.ctrlKey) && event.key.toLowerCase() === 'k') {
            event.preventDefault();
            if (dialog().open) dialog().close();
            else open();
            return;
        }
        if (!dialog().open) {
            if (event.key === 't' && !typing(event.target) && !event.metaKey && !event.ctrlKey)
                document.querySelector<HTMLButtonElement>('[data-theme-toggle]')?.click();
            return;
        }
        if (event.key === 'ArrowDown' || event.key === 'ArrowUp') {
            event.preventDefault();
            select(active + (event.key === 'ArrowDown' ? 1 : -1));
        } else if (event.key === 'Enter') {
            event.preventDefault();
            const item = visibleItems()[active];
            if (item) run(item);
        }
    });

    document.addEventListener('input', event => {
        if ((event.target as Element).matches('[data-command-input]')) filter();
    });

    document.addEventListener('click', event => {
        const target = event.target as Element;
        if (target.closest('[data-command-open]')) return open();
        const item = target.closest<HTMLElement>('[data-command] [data-item]');
        if (item) return run(item);
        // A click on the backdrop lands on the dialog itself.
        if (target === dialog()) dialog().close();
    });

    document.addEventListener('mousemove', event => {
        const item = (event.target as Element).closest<HTMLElement>('[data-command] [data-item]');
        if (item) select(visibleItems().indexOf(item));
    });
</script>
