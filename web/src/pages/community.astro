---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { getCommunity, image, type CommunityEntry } from '../lib/content';

const entries = getCommunity();
const of = (kind: CommunityEntry['kind']) =>
    entries.filter(e => e.kind === kind).sort((a, b) => (a.order ?? 100) - (b.order ?? 100));
const communities = of('community');
const lists = [
    { title: 'Talks', about: 'Sessions at meetups and student developer events.', items: of('talk') },
    { title: 'Mentoring & judging', about: 'Helping other people build, at hackathons and open-source programmes.', items: of('mentoring') }
].filter(l => l.items.length > 0);
const counts = [
    [communities.length, 'communities'],
    [of('talk').length, 'talks'],
    [of('mentoring').length, 'mentor and judge roles']
].filter(([n]) => Number(n) > 0);
---

<Base title="Community" description="Communities Pranav Agarwal has founded and led, talks he has given, and hackathons he has mentored and judged." wide>
    <header class="reveal flex flex-wrap items-end justify-between gap-4 pt-10 md:pt-14">
        <div>
            <p class="eyebrow">Community</p>
            <h1 class="mt-2 text-4xl tracking-[-0.035em] sm:text-5xl">Building with other people</h1>
            <p class="mt-3 max-w-[56ch] text-[15px] leading-relaxed text-dim">
                Communities I've started and led, talks I've given, and hackathons I've helped run, mentor and judge.
            </p>
        </div>
        <p class="font-mono text-xs text-faint">{counts.map(([n, label]) => `${n} ${label}`).join(' · ')}</p>
    </header>

    {
        communities.length > 0 && (
            <section class="reveal mt-12" style="--delay: 0.1s" data-component="Communities">
                <h2 class="mb-5 text-xl">Communities</h2>
                <div class="grid gap-4 md:grid-cols-2">
                    {communities.map(c => (
                        <article class="card group relative flex flex-col p-5 transition-colors hover:border-line-strong sm:p-6">
                            <div class="flex items-start gap-4">
                                {c.image && (
                                    <Image src={image(c.image)} alt="" widths={[96]} sizes="48px" class="size-12 shrink-0 rounded-xl border border-line object-cover" />
                                )}
                                <div class="min-w-0 grow">
                                    <p class="flex flex-wrap items-center gap-x-3 gap-y-1">
                                        {c.role && <span class="eyebrow">{c.role}</span>}
                                        {c.period && <span class="font-mono text-xs text-faint">{c.period}</span>}
                                    </p>
                                    <h3 class="mt-1.5 text-lg leading-snug font-medium text-pretty">
                                        {c.url ? (
                                            <a href={c.url} target="_blank" rel="noopener noreferrer" class="after:absolute after:inset-0 group-hover:text-accent">
                                                {c.title}
                                            </a>
                                        ) : (
                                            c.title
                                        )}
                                    </h3>
                                </div>
                                {c.url && <Icon name="arrow-right-up-line" class="size-4 shrink-0 text-faint transition-transform group-hover:-translate-y-0.5 group-hover:translate-x-0.5 group-hover:text-accent" />}
                            </div>
                            {c.description && <p class="mt-3 text-[14px] leading-relaxed text-dim">{c.description}</p>}
                            {c.highlights && c.highlights.length > 0 && (
                                <p class="mt-4 flex flex-wrap gap-1.5">
                                    {c.highlights.map(h => <span class="chip">{h}</span>)}
                                </p>
                            )}
                        </article>
                    ))}
                </div>
            </section>
        )
    }

    {
        lists.map((list, i) => (
            <section class="reveal mt-14" style={`--delay: ${0.15 + i * 0.05}s`} data-component="CommunityList">
                <div class="mb-5">
                    <h2 class="text-xl">{list.title}</h2>
                    <p class="mt-1 text-[13.5px] text-dim">{list.about}</p>
                </div>
                <ol class="card divide-y divide-line overflow-hidden">
                    {list.items.map(item => (
                        <li class:list={['group relative grid gap-x-8 gap-y-1.5 px-5 py-5 sm:grid-cols-[1fr_auto] sm:px-6', item.url && 'transition-colors hover:bg-raised']}>
                            <div class="min-w-0">
                                <h3 class="text-base leading-snug font-medium text-pretty sm:text-[17px]">
                                    {item.url ? (
                                        <a href={item.url} target="_blank" rel="noopener noreferrer" class="after:absolute after:inset-0 group-hover:text-accent">
                                            {item.title}
                                        </a>
                                    ) : (
                                        item.title
                                    )}
                                </h3>
                                <p class="mt-1 text-sm text-dim">{[item.role, item.organisation].filter(Boolean).join(' · ')}</p>
                                {item.description && <p class="mt-2 max-w-[70ch] text-sm leading-relaxed text-dim">{item.description}</p>}
                                {item.highlights && item.highlights.length > 0 && (
                                    <p class="mt-3 flex flex-wrap gap-1.5">
                                        {item.highlights.map(h => <span class="chip">{h}</span>)}
                                    </p>
                                )}
                            </div>
                            {item.period && <p class="order-first font-mono text-xs text-faint sm:order-none sm:pt-1 sm:text-right">{item.period}</p>}
                        </li>
                    ))}
                </ol>
            </section>
        ))
    }
</Base>
