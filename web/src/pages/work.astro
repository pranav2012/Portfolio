---
import Base from '../layouts/Base.astro';
import WorkCard from '../components/WorkCard.astro';
import { getProjects } from '../lib/content';

const projects = getProjects();
const groups = [
    { title: 'Works', items: projects.filter(p => p.section === 'featured') },
    { title: 'Open source & tools', items: projects.filter(p => p.section === 'oss') },
    { title: 'Earlier work', items: projects.filter(p => p.section === 'archive') }
].filter(group => group.items.length > 0);
---

<Base title="Works" description="Things Pranav Agarwal has built: apps, developer tools and open source.">
    {
        groups.map((group, i) => (
            <section class="reveal" style={`--delay: ${i * 0.15}s`}>
                {i > 0 && <hr class="my-6 border-line" />}
                <h1 class="mb-4 text-xl">{group.title}</h1>
                <div class="grid gap-x-6 gap-y-10 sm:grid-cols-2">
                    {group.items.map(project => (
                        <WorkCard project={project} />
                    ))}
                </div>
            </section>
        ))
    }
</Base>
