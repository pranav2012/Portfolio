---
import Base from '../layouts/Base.astro';
import VideoCard from '../components/VideoCard.astro';
import { getProfile, getVideos } from '../lib/content';

const videos = getVideos();
const channel = getProfile().socials?.find(s => s.platform === 'youtube')?.url;
---

<Base title="Videos" description="Videos by Pranav Agarwal on YouTube.">
    <section class="reveal">
        <h1 class="mb-4 text-xl">Videos</h1>
        <div class="grid gap-x-6 gap-y-10 sm:grid-cols-2">
            {videos.map(video => <VideoCard video={video} />)}
        </div>
        {
            channel && (
                <p class="my-8 text-center">
                    <a href={channel} target="_blank" rel="noopener noreferrer" class="btn">
                        My YouTube channel
                    </a>
                </p>
            )
        }
    </section>
</Base>
