---
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import PostRow from '../../components/PostRow.astro';
import { getPosts, type Post } from '../../lib/content';

const posts = getPosts();
const byYear = new Map<string, Post[]>();
for (const post of posts) {
    const year = post.publishedAt.slice(0, 4);
    byYear.set(year, [...(byYear.get(year) ?? []), post]);
}
---

<Base title="Blog" description="Notes on frontend craft, mobile and AI-native development." wide>
    <header class="reveal flex flex-wrap items-end justify-between gap-4 pt-10 md:pt-14">
        <div>
            <p class="eyebrow">Writing</p>
            <h1 class="mt-2 text-4xl tracking-[-0.035em] sm:text-5xl">Blog</h1>
            <p class="mt-3 max-w-[56ch] text-[15px] leading-relaxed text-dim">
                Long-form write-ups of things I've built and debugged, mostly mobile, graphics and self-hosting. Newest first.
            </p>
        </div>
        <p class="flex items-center gap-4 font-mono text-xs text-faint">
            <span>{posts.length} {posts.length === 1 ? 'post' : 'posts'}</span>
            <a href="/rss.xml" class="flex items-center gap-1 hover:text-ink">
                <Icon name="rss-line" class="size-3.5" />
                RSS
            </a>
        </p>
    </header>

    {
        posts.length > 0 ? (
            [...byYear].map(([year, yearPosts], i) => (
                <section class="reveal mt-10 md:mt-12" style={`--delay: ${0.1 + i * 0.05}s`} aria-labelledby={`year-${year}`}>
                    <h2 id={`year-${year}`} class="mb-3 flex items-center gap-3 font-mono text-xs font-medium tracking-[0.06em] text-faint">
                        {year}
                        <span class="h-px flex-1 bg-line" aria-hidden="true" />
                    </h2>
                    <ol class="card divide-y divide-line overflow-hidden">
                        {yearPosts.map(post => (
                            <PostRow post={post} heading="h3" shortDate />
                        ))}
                    </ol>
                </section>
            ))
        ) : (
            <p class="reveal mt-10 text-dim">
                No posts yet. Follow the <a href="/rss.xml" class="link">RSS feed</a> to get the first one.
            </p>
        )
    }
</Base>
