---
import Base from '../../layouts/Base.astro';
import PageHeader from '../../components/PageHeader.astro';
import PostIndex from '../../components/PostIndex.astro';
import { getPosts } from '../../lib/content';

const posts = await getPosts();
---

<Base title="Blog" description="Notes on frontend craft, mobile and AI-native development.">
    <PageHeader title="Blog" intro="Notes on frontend craft, mobile and AI-native development." />
    <div class="mx-auto mt-14 max-w-6xl px-5 sm:px-8">
        <div class="max-w-3xl">
            {
                posts.length > 0 ? (
                    <PostIndex posts={posts} />
                ) : (
                    <p class="border-t border-line pt-6 text-muted">
                        No posts yet. Follow the <a href="/rss.xml" class="link-quiet">RSS feed</a> to get the
                        first one.
                    </p>
                )
            }
        </div>
    </div>
</Base>
