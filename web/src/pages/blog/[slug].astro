---
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import { formatDate, getPosts, highlightCode, image, localiseImages, type Post } from '../../lib/content';

export function getStaticPaths() {
    return getPosts().map(post => ({ params: { slug: post.slug }, props: { post } }));
}

const { post } = Astro.props as { post: Post };
const html = post.contentHtml ? await highlightCode(await localiseImages(post.contentHtml)) : '';
---

<Base title={post.title} description={post.excerpt} type="article">
    <article class="reveal">
        <p class="text-sm">
            <a href="/blog" class="link">Blog</a>
            <span class="opacity-50"> / </span>
        </p>
        <h1 class="mt-2 text-3xl leading-tight">{post.title}</h1>
        <p class="mt-2 flex flex-wrap gap-2 text-xs opacity-70">
            <span>{formatDate(post.publishedAt)}</span>
            {post.tags?.map(tag => <span class="rounded bg-line px-1.5 py-0.5">{tag}</span>)}
        </p>
        {
            post.cover && (
                <Image
                    src={image(post.cover)}
                    alt={post.cover.alt}
                    widths={[640, 1200]}
                    sizes="(min-width: 640px) 600px, 100vw"
                    class="mt-6 w-full rounded-xl"
                />
            )
        }
        <div class="prose mt-6" set:html={html} />
    </article>
</Base>
