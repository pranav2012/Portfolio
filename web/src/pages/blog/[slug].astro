---
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import { formatDate, getPosts, image, localiseImages, type Post } from '../../lib/content';

export async function getStaticPaths() {
    const posts = await getPosts();
    return posts.map(post => ({ params: { slug: post.slug }, props: { post } }));
}

const { post } = Astro.props as { post: Post };
const html = post.contentHtml ? await localiseImages(post.contentHtml) : '';
---

<Base title={post.title} description={post.excerpt} type="article">
    <article class="mx-auto max-w-3xl px-5 pt-14 sm:px-8 sm:pt-20">
        <a href="/blog" class="link text-sm text-muted">Blog</a>
        <h1 class="mt-4 font-display text-[clamp(2.25rem,6vw,3.75rem)] leading-[1.02] font-bold tracking-[-0.025em] [font-stretch:88%]">
            {post.title}
        </h1>
        <p class="mt-4 flex flex-wrap gap-x-4 gap-y-1 text-sm text-muted">
            <time datetime={post.publishedAt}>{formatDate(post.publishedAt)}</time>
            {post.tags?.map(tag => <span>#{tag}</span>)}
        </p>
        {
            post.cover && (
                <Image
                    src={image(post.cover)}
                    alt={post.cover.alt}
                    widths={[720, 1200, 1600]}
                    sizes="(min-width: 768px) 720px, 100vw"
                    class="mt-10 w-full rounded-2xl border border-line"
                />
            )
        }
        <div class="prose mt-10" set:html={html} />
    </article>
</Base>
