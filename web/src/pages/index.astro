---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import WorkCard from '../components/WorkCard.astro';
import DeskScene from '../components/DeskScene.astro';
import PerfBadge from '../components/PerfBadge.astro';
import PostRow from '../components/PostRow.astro';
import { getPosts, getProfile, getProjects } from '../lib/content';

const profile = getProfile();
const projects = getProjects().filter(p => p.showOnHome);
const posts = getPosts().slice(0, 3);
const email = profile.socials?.find(s => s.platform === 'email')?.url;
const socials = profile.socials?.filter(s => s.platform !== 'email') ?? [];

const icons: Record<string, string> = {
    github: 'github-fill',
    linkedin: 'linkedin-box-fill',
    x: 'twitter-x-fill',
    email: 'mail-fill',
    medium: 'medium-fill',
    youtube: 'youtube-fill',
    stackoverflow: 'stack-overflow-fill',
    website: 'global-line'
};


// Short year ranges for the timeline, e.g. "Jan 2022 – Present" → "2022 — Now".
const years = (period?: string | null) => {
    if (!period) return '';
    const [from, to] = period.split(/\s*[–-]\s*/).map(part => part.match(/\d{4}/)?.[0] ?? (/present/i.test(part) ? 'Now' : part));
    return to && to !== from ? `${from} — ${to}` : from;
};
---

<Base wide>
    <section class="grid items-center gap-10 pt-6 pb-4 md:pt-16 lg:grid-cols-[1.1fr_0.9fr] lg:gap-12" data-component="Hero">
        <div class="reveal flex flex-col items-start gap-6">
            <div>
                <h1 class="bg-gradient-to-r from-ink to-dim bg-clip-text text-5xl leading-[1.02] tracking-[-0.045em] text-transparent sm:text-6xl lg:text-[68px]">
                    {profile.name}
                </h1>
                <p class="mt-4 text-lg tracking-tight text-dim sm:text-xl">
                    <span class="font-medium text-ink">Frontend engineer</span> crafting fast, native-feeling interfaces for web, mobile &amp; AI tooling.
                </p>
            </div>
            {profile.aboutHtml && <div class="prose hidden max-w-[52ch] text-[15px] sm:block [&>p:not(:first-child)]:hidden" set:html={profile.aboutHtml} />}
            {
                profile.experience && profile.experience.length > 0 && (
                    <div class="w-full max-w-[460px]" data-component="Experience">
                        <p class="mb-3 font-mono text-[11px] tracking-wider text-faint uppercase">Experience</p>
                        <ol class="relative space-y-3 pl-6 before:absolute before:top-2 before:bottom-2 before:left-[5px] before:w-px before:bg-gradient-to-b before:from-accent before:via-line-strong before:to-line">
                            {profile.experience.map((job, i) => (
                                <li class="relative flex items-baseline justify-between gap-4 text-sm">
                                    <span
                                        class:list={[
                                            'absolute top-[5px] -left-6 size-[11px] rounded-full border-2',
                                            i === 0 ? 'border-accent bg-page shadow-[0_0_0_4px_var(--glow),0_0_12px_var(--accent)]' : 'border-line-strong bg-page'
                                        ]}
                                    />
                                    <span class="min-w-0 truncate">
                                        {job.companyUrl ? (
                                            <a href={job.companyUrl} target="_blank" rel="noopener noreferrer" class:list={['hover:text-accent', i === 0 ? 'font-semibold' : 'font-medium']}>
                                                {job.company}
                                            </a>
                                        ) : (
                                            <span class:list={[i === 0 ? 'font-semibold' : 'font-medium']}>{job.company}</span>
                                        )}
                                        <span class="hidden text-dim sm:inline"> · {job.role}</span>
                                    </span>
                                    <span class:list={['shrink-0 font-mono text-xs', i === 0 ? 'text-accent' : 'text-faint']}>{years(job.period)}</span>
                                </li>
                            ))}
                        </ol>
                    </div>
                )
            }
            <div class="flex flex-wrap items-center gap-3">
                {
                    profile.resumeUrl && (
                        <a href={profile.resumeUrl} target="_blank" rel="noopener noreferrer" class="btn">
                            <Icon name="file-text-line" class="size-4" />
                            Resume
                        </a>
                    )
                }
                {
                    email && (
                        <a href={email} class="btn-ghost">
                            <Icon name="mail-line" class="size-4" />
                            Get in touch
                        </a>
                    )
                }
                <span class="mx-1 hidden h-6 w-px bg-line-strong sm:block" />
                <ul class="flex gap-1.5">
                    {
                        socials.map(social => (
                            <li>
                                <a href={social.url} target="_blank" rel="noopener noreferrer" class="icon-btn" aria-label={social.label} title={social.label}>
                                    <Icon name={icons[social.platform] ?? 'global-line'} class="size-[18px]" />
                                </a>
                            </li>
                        ))
                    }
                </ul>
            </div>
        </div>

        <div class="reveal relative z-10 order-first lg:order-none" style="--delay: 0.1s">
            <!-- Outside the card's clipping, so the vitals panel can overflow it. -->
            <div class="absolute top-0 left-0 z-10 p-4"><PerfBadge /></div>
            <div class="card relative aspect-[4/3] overflow-hidden rounded-3xl bg-[radial-gradient(circle_at_50%_55%,var(--glow),transparent_62%)] sm:aspect-[5/4] lg:aspect-square">
                <DeskScene persist="desk-hero" class="absolute inset-0" withPoster />
                <p class="pointer-events-none absolute inset-x-0 bottom-4 text-center font-mono text-[11px] text-faint">
                    drag to rotate · click him to say hi
                </p>
            </div>
        </div>
    </section>


    {
        projects.length > 0 && (
            <section class="reveal mt-14 sm:mt-24" style="--delay: 0.2s" data-component="SelectedWork">
                <div class="mb-6 flex items-end justify-between gap-4">
                    <div>
                        <p class="eyebrow">Selected work</p>
                        <h2 class="mt-2 text-[26px]">Things I've built</h2>
                    </div>
                    <a href="/work" class="group flex items-center gap-1 text-sm text-dim hover:text-ink">
                        All work
                        <Icon name="arrow-right-line" class="size-4 transition-transform group-hover:translate-x-0.5" />
                    </a>
                </div>
                <div class="-mx-5 flex snap-x snap-mandatory gap-3 overflow-x-auto scroll-px-5 px-5 pb-2 [scrollbar-width:none] *:w-[85%] *:shrink-0 *:snap-start sm:-mx-8 sm:scroll-px-8 sm:px-8 sm:*:w-[60%] md:mx-0 md:grid md:grid-cols-2 md:gap-5 md:overflow-visible md:px-0 md:pb-0 md:*:w-auto">
                    {projects.map(project => (
                        <WorkCard project={project} />
                    ))}
                </div>
            </section>
        )
    }


    {
        posts.length > 0 && (
            <section class="reveal mt-14 sm:mt-24" style="--delay: 0.25s" data-component="LatestPosts">
                <div class="mb-6 flex items-end justify-between gap-4">
                    <div>
                        <p class="eyebrow">Writing</p>
                        <h2 class="mt-2 text-[26px]">Latest from the blog</h2>
                    </div>
                    <a href="/blog" class="group flex items-center gap-1 text-sm text-dim hover:text-ink">
                        All posts
                        <Icon name="arrow-right-line" class="size-4 transition-transform group-hover:translate-x-0.5" />
                    </a>
                </div>
                <ol class="card divide-y divide-line overflow-hidden">
                    {posts.map(post => (
                        <PostRow post={post} />
                    ))}
                </ol>
            </section>
        )
    }

    <section
        class="reveal card mt-14 flex sm:mt-24 flex-col items-start justify-between gap-6 bg-[radial-gradient(circle_at_100%_0%,var(--glow),transparent_55%)] p-8 sm:flex-row sm:items-center sm:p-10"
        style="--delay: 0.3s"
        data-component="ContactCard"
    >
        <div>
            <h2 class="text-2xl">Let's build something fast.</h2>
            <p class="mt-1.5 text-[15px] text-dim">Open to interesting frontend and mobile problems.</p>
        </div>
        <div class="flex items-center gap-3">
            <button type="button" data-command-open class="btn-ghost">
                Press <span class="kbd">⌘K</span>
            </button>
            {
                email && (
                    <a href={email} class="btn">
                        Email me
                        <Icon name="arrow-right-up-line" class="size-4" />
                    </a>
                )
            }
        </div>
    </section>
</Base>
