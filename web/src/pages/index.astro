---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import WorkCard from '../components/WorkCard.astro';
import { getProfile, getProjects, image } from '../lib/content';

const profile = getProfile();
const projects = getProjects().filter(p => p.showOnHome);

const icons: Record<string, string> = {
    github: 'github-fill',
    linkedin: 'linkedin-box-fill',
    x: 'twitter-x-fill',
    email: 'mail-fill',
    medium: 'medium-fill',
    youtube: 'youtube-fill',
    stackoverflow: 'stack-overflow-fill',
    website: 'global-line'
};
---

<Base>
    {
        profile.greeting && (
            <p class="reveal mb-6 rounded-lg bg-soft p-3 text-center">{profile.greeting}</p>
        )
    }

    <div class="reveal flex flex-col gap-4 md:flex-row md:items-center">
        <div class="grow">
            <h1 class="text-3xl">{profile.name}</h1>
            <p>{profile.role}</p>
        </div>
        {
            profile.photo && (
                <Image
                    src={image(profile.photo)}
                    alt={profile.name}
                    width={100}
                    height={100}
                    densities={[1, 2]}
                    class="mx-auto size-[100px] rounded-full border-2 border-white/80 object-cover md:mx-0"
                />
            )
        }
    </div>

    {
        profile.aboutHtml && (
            <section class="reveal mt-6" style="--delay: 0.1s">
                <h2 class="section-title">About Me</h2>
                <div class="prose text-justify" set:html={profile.aboutHtml} />
                {profile.resumeUrl && (
                    <p class="my-5 text-center">
                        <a href={profile.resumeUrl} target="_blank" rel="noopener noreferrer" class="btn">
                            My Resume
                            <Icon name="arrow-right-s-line" class="size-5" />
                        </a>
                    </p>
                )}
            </section>
        )
    }

    {
        profile.experience && profile.experience.length > 0 && (
            <section class="reveal mt-6" style="--delay: 0.2s">
                <h2 class="section-title">Experience</h2>
                <ul class="space-y-3">
                    {profile.experience.map(job => (
                        <li>
                            <p class="font-semibold">
                                {job.role} at{' '}
                                {job.companyUrl ? (
                                    <a href={job.companyUrl} target="_blank" rel="noopener noreferrer" class="link">
                                        {job.company}
                                    </a>
                                ) : (
                                    job.company
                                )}
                            </p>
                            <p class="text-xs font-bold text-year">
                                {[job.location, job.period].filter(Boolean).join(', ')}
                            </p>
                            {job.description && <p class="mt-1 text-sm">{job.description}</p>}
                        </li>
                    ))}
                </ul>
            </section>
        )
    }

    {
        profile.education && profile.education.length > 0 && (
            <section class="reveal mt-6" style="--delay: 0.2s">
                <h2 class="section-title">Education</h2>
                {profile.education.map(item => (
                    <p>
                        {item.degree}, {item.school}
                        {item.year && <span class="ml-1 text-xs font-bold text-year">({item.year})</span>}
                    </p>
                ))}
            </section>
        )
    }

    {
        projects.length > 0 && (
            <section class="reveal mt-6" style="--delay: 0.3s">
                <h2 class="section-title">Recent Work</h2>
                <div class="grid gap-6 sm:grid-cols-2">
                    {projects.map(project => (
                        <WorkCard project={project} />
                    ))}
                </div>
                <p class="my-5 text-center">
                    <a href="/work" class="btn">
                        All my work
                        <Icon name="arrow-right-s-line" class="size-5" />
                    </a>
                </p>
            </section>
        )
    }

    {
        profile.interests && (
            <section class="reveal mt-6" style="--delay: 0.3s">
                <h2 class="section-title">
                    I <span class="text-red-500">♥</span>
                </h2>
                <p>{profile.interests}</p>
            </section>
        )
    }

    {
        profile.socials && profile.socials.length > 0 && (
            <section class="reveal mt-6" style="--delay: 0.3s">
                <h2 class="section-title">Let's Connect</h2>
                <ul class="grid grid-cols-2 gap-2 sm:grid-cols-3">
                    {profile.socials.map(social => (
                        <li>
                            <a
                                href={social.url}
                                target={social.platform === 'email' ? undefined : '_blank'}
                                rel="noopener noreferrer"
                                class="btn-ghost"
                            >
                                <Icon name={icons[social.platform] ?? 'global-line'} class="size-5" />
                                {social.label}
                            </a>
                        </li>
                    ))}
                </ul>
            </section>
        )
    }
</Base>
