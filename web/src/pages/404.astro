---
import Base from '../layouts/Base.astro';
---

<Base title="Page not found">
    <div class="mx-auto max-w-6xl px-5 pt-20 sm:px-8">
        <h1 class="font-display text-[clamp(2.75rem,8vw,5rem)] leading-[0.95] font-bold tracking-[-0.03em] [font-stretch:85%]">
            Nothing at this address
        </h1>
        <p class="mt-5 max-w-xl text-lg text-muted">
            The page may have moved. Head to the <a href="/" class="link-quiet">home page</a>, or see my
            <a href="/work" class="link-quiet">work</a>.
        </p>
    </div>
</Base>
